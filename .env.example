# Copy to .env (gitignored). Generate the secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
MCP_SECRET=
MCP_PORT=8766
# Public hostname routed to this PC by the Cloudflare tunnel
MCP_PUBLIC_HOST=tv.example.com
# Name of the tunnel created with `cloudflared tunnel create`
TUNNEL_NAME=stremio-tv
